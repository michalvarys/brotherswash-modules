        <record id="cat_premium" model="bw.service.category">
            <field name="name">Prémiové služby</field>
            <field name="description">Dlouhodobá ochrana a profesionální péče</field>
            <field name="category_type">premium</field>
            <field name="icon">fa-star</field>
            <field name="sequence">1</field>
        </record>

        <record id="cat_program" model="bw.service.category">
