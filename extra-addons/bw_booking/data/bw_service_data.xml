        <!-- ===== PREMIUM SERVICES ===== -->
        <record id="svc_keramika" model="bw.service">
            <field name="name">Keramická ochrana laku</field>
            <field name="category_id" ref="cat_premium"/>
            <field name="short_description">Garantovaná ochrana až 3 roky</field>
            <field name="description"><![CDATA[
                <p>Profesionální keramický povlak vytvářející tvrdou ochrannou vrstvu. Chrání lak před UV zářením, solí, chemikáliemi, hmyzem i drobnými škrábanci.</p>
                <p>Součást balíčku je servisní kniha a kontrola každých 6 měsíců:</p>
                <ul>
                    <li>Kontrola stavu keramické ochrany</li>
                    <li>Údržbové mytí vozu zdarma</li>
                    <li>Případné doplnění ochranné vrstvy</li>
                </ul>
            ]]></field>
            <field name="is_highlighted" eval="True"/>
            <field name="sequence">1</field>
        </record>
        <record id="svc_keramika_price_sedan" model="bw.service.price">
            <field name="service_id" ref="svc_keramika"/>
            <field name="vehicle_type_id" ref="vehicle_type_sedan"/>
            <field name="price">8000</field>
        </record>
        <record id="svc_keramika_price_suv" model="bw.service.price">
            <field name="service_id" ref="svc_keramika"/>
            <field name="vehicle_type_id" ref="vehicle_type_suv"/>
            <field name="price">9000</field>
        </record>

        <record id="svc_lesteni" model="bw.service">
            <field name="name">Hloubkové leštění karoserie</field>
            <field name="category_id" ref="cat_premium"/>
