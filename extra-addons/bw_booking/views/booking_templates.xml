<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== BOOKING CONFIGURATOR PAGE ===== -->
    <template id="booking_page" name="Booking - Brothers Wash Detailing">
        <t t-call="website.layout">
            <t t-set="additional_title">Reservation</t>
            <div id="wrap" class="oe_structure">
                <div class="bw-booking-page">

                    <!-- Hero -->
                    <section class="bw-booking-hero">
                        <div class="container text-center">
                            <h1>Reservation</h1>
                            <p class="lead">Choose your services and a date, and we will send you a confirmation.</p>
                        </div>
                    </section>

                    <form action="/booking/submit" method="post" id="bwBookingForm" class="container bw-booking-form"
                          data-currency-suffix=",- Kč">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="bw_tracking" id="bwTrackingInput" value="{}"/>

                        <!-- Step 1: Vehicle Type -->
                        <section class="bw-step" id="bwStep1">
                            <h2 class="bw-step-title"><span class="bw-step-num">1</span> Vehicle type</h2>
                            <div class="bw-vehicle-types">
                                <t t-foreach="vehicle_types" t-as="vt">
                                    <label class="bw-vehicle-card" t-att-data-id="vt.id">
                                        <input type="radio" name="vehicle_type_id" t-att-value="vt.id" required="required"/>
                                        <div class="bw-vehicle-card-inner">
                                            <i class="fa fa-car fa-2x"/>
                                            <span t-field="vt.name"/>
                                        </div>
                                    </label>
                                </t>
                            </div>
                        </section>

                        <!-- Step 2: Services -->
                        <section class="bw-step" id="bwStep2">
                            <h2 class="bw-step-title"><span class="bw-step-num">2</span> Choose services</h2>

                            <t t-set="bw_badge_label">Recommended</t>
                            <t t-foreach="categories" t-as="cat">
                                <div class="bw-service-group">
                                    <h3 class="bw-service-group-title">
                                        <i t-att-class="'fa ' + (cat.icon or 'fa-wrench')"/>
                                        <t t-esc="cat.name"/>
                                    </h3>
                                    <t t-if="cat.description">
                                        <p class="bw-service-group-desc" t-esc="cat.description"/>
                                    </t>

                                    <div class="bw-service-list">
                                        <t t-foreach="services.filtered(lambda s: s.category_id.id == cat.id)" t-as="svc">
                                            <label t-attf-class="bw-service-item #{'bw-service-item--highlight' if svc.is_highlighted else ''}"
                                                   t-att-data-service-id="svc.id"
                                                   t-att-data-badge="bw_badge_label if svc.is_highlighted else None">
                                                <div class="bw-service-check">
                                                    <input type="checkbox" t-att-name="'service_%d' % svc.id"/>
                                                </div>
                                                <div class="bw-service-info">
                                                    <strong t-field="svc.name"/>
                                                    <t t-if="svc.short_description">
                                                        <small t-field="svc.short_description"/>
                                                    </t>
                                                    <t t-if="svc.duration_info">
                                                        <span class="bw-duration">
                                                            <i class="fa fa-clock-o"/> <t t-esc="svc.duration_info"/>
                                                        </span>
                                                    </t>
                                                </div>
                                                <div class="bw-service-price" t-att-data-service-id="svc.id">
                                                    <span class="bw-price-value">--</span>
                                                    <span class="bw-price-suffix">,- Kč</span>
                                                </div>
                                            </label>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </section>

                        <!-- Total -->
                        <section class="bw-total-bar" id="bwTotalBar">
                            <div class="bw-total-inner">
                                <span>Total price:</span>
                                <strong id="bwTotalPrice">0,- Kč</strong>
                            </div>
                        </section>

                        <!-- Step 3: Contact + Date -->
                        <section class="bw-step" id="bwStep3">
                            <h2 class="bw-step-title"><span class="bw-step-num">3</span> Contact details</h2>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Full name *</label>
                                        <input type="text" name="customer_name" class="form-control" required="required"
                                               placeholder="e.g. John Smith"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Email *</label>
                                        <input type="email" name="customer_email" class="form-control" required="required"
                                               placeholder="jan@example.com"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Phone *</label>
                                        <input type="tel" name="customer_phone" class="form-control" required="required"
                                               placeholder="+420 ..."/>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label">Car (make / model)</label>
                                        <input type="text" name="vehicle_info" class="form-control"
                                               placeholder="e.g. Škoda Octavia"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Preferred date</label>
                                        <input type="datetime-local" name="preferred_date" class="form-control"/>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Note</label>
                                        <textarea name="customer_note" class="form-control" rows="3"/>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Submit -->
                        <section class="bw-step text-center">
                            <button type="submit" class="btn btn-lg bw-btn-submit" id="bwSubmitBtn">
                                <i class="fa fa-paper-plane"/> Submit reservation
                            </button>
                        </section>
                    </form>

                </div>
            </div>
        </t>
    </template>

    <!-- ===== THANK YOU PAGE ===== -->
    <template id="booking_thank_you" name="Thank you - Brothers Wash Detailing">
        <t t-call="website.layout">
            <t t-set="additional_title">Thank you</t>
            <div id="wrap" class="oe_structure">
                <div class="bw-booking-page">
                    <section class="bw-booking-hero">
                        <div class="container text-center">
                            <h1>Thank you!</h1>
                        </div>
                    </section>

                    <div id="bw_booking_conversion" class="d-none" t-att-data-tracking="bw_tracking_json"></div>
                    <div class="container bw-thank-you">
                        <div class="bw-thank-you-card">
                            <div class="bw-thank-you-icon">
                                <i class="fa fa-check-circle"/>
                            </div>
                            <h2>Your reservation has been received</h2>
                            <p>Reservation number: <strong>BWD-<t t-esc="booking.id"/></strong></p>
                            <p>We have sent a confirmation to <strong><t t-esc="booking.customer_email"/></strong>.</p>
                            <p>We will contact you to confirm the appointment.</p>

                            <div class="bw-thank-you-summary">
                                <h3>Summary</h3>
                                <table class="table">
                                    <tbody>
                                        <t t-foreach="booking.line_ids" t-as="line">
                                            <tr>
                                                <td t-esc="line.service_id.name"/>
                                                <td class="text-end"><t t-esc="'%.0f' % line.price"/>,- Kč</td>
                                            </tr>
                                        </t>
                                        <tr class="bw-total-row">
                                            <td><strong>Total</strong></td>
                                            <td class="text-end"><strong><t t-esc="'%.0f' % booking.total_price"/>,- Kč</strong></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <a href="/" class="btn bw-btn-submit mt-3">
                                <i class="fa fa-home"/> Back to the homepage
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Inject price_map_json as script data -->
    <template id="booking_page_js_data" inherit_id="bw_booking.booking_page" name="Booking Price Data">
        <xpath expr="//form[@id='bwBookingForm']" position="before">
            <script type="text/javascript">
                var bwPriceMap = <t t-raw="price_map_json"/>;
            </script>
        </xpath>
    </template>

</odoo>
