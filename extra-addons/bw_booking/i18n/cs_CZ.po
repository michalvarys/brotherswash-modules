#. module: bw_booking
#: model:mail.template,body_html:bw_booking.mail_template_booking_pending
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;\">\n"
"    <table width=\"100%\" style=\"max-width:600px;margin:0 auto;background:#ffffff;\">\n"
"        <tr>\n"
"            <td style=\"background:#1a1a1a;padding:30px;text-align:center;\">\n"
"                <h1 style=\"color:#c8a961;margin:0;font-size:24px;\">{{ object.env.company.name }}</h1>\n"
"            </td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding:30px;\">\n"
"                <h2 style=\"color:#1a1a1a;margin-top:0;\">Thank you for your reservation!</h2>\n"
"                <p>Hello, <strong>{{ object.customer_name }}</strong>,</p>\n"
"                <p>Your reservation has been successfully received and is awaiting confirmation. We will contact you to confirm the appointment.</p>\n"
"\n"
"                <table width=\"100%\" style=\"margin:20px 0;border-collapse:collapse;\">\n"
"                    <tr style=\"background:#f5f5f5;\">\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\">Reservation number</td>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;\">BWD-{{ object.id }}</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\">Vehicle</td>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;\">{{ object.vehicle_type_id.name }} - {{ object.vehicle_info or 'not specified' }}</td>\n"
"                    </tr>\n"
"                    <tr style=\"background:#f5f5f5;\">\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\">Preferred date</td>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;\">{{ object.preferred_date and object.preferred_date.strftime('%d.%m.%Y %H:%M') or 'not specified' }}</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\">Total price</td>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;color:#c8a961;\">{{ object.is_price_approximate and 'from ' or '' }}{{ '%.0f' % object.total_price }},- Kč</td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <h3 style=\"color:#1a1a1a;\">Selected services:</h3>\n"
"                <ul style=\"padding-left:20px;\">\n"
"                    % for line in object.line_ids:\n"
"                    <li>{{ line.service_id.name }} - {{ line.price_prefix and line.price_prefix + ' ' or '' }}{{ '%.0f' % line.price }},- Kč</li>\n"
"                    % endfor\n"
"                </ul>\n"
"\n"
"                % if object.customer_note:\n"
"                <p><strong>Your note:</strong> {{ object.customer_note }}</p>\n"
"                % endif\n"
"\n"
"                <p style=\"margin-top:20px;color:#666;\">Reservation status: <strong style=\"color:#e67e22;\">Awaiting confirmation</strong></p>\n"
"            </td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"background:#1a1a1a;padding:20px;text-align:center;color:#888;font-size:12px;\">\n"
"                <p style=\"margin:0;\">{{ object.env.company.name }} | {{ object.env.company.street or '' }}, {{ object.env.company.city or '' }}</p>\n"
"            </td>\n"
"        </tr>\n"
"    </table>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;\">\n"
"    <table width=\"100%\" style=\"max-width:600px;margin:0 auto;background:#ffffff;\">\n"
"        <tr>\n"
"            <td style=\"background:#1a1a1a;padding:30px;text-align:center;\">\n"
"                <h1 style=\"color:#c8a961;margin:0;font-size:24px;\">{{ object.env.company.name }}</h1>\n"
"            </td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding:30px;\">\n"
"                <h2 style=\"color:#1a1a1a;margin-top:0;\">Děkujeme za Vaši rezervaci!</h2>\n"
"                <p>Dobrý den, <strong>{{ object.customer_name }}</strong>,</p>\n"
"                <p>Vaše rezervace byla úspěšně přijata a čeká na potvrzení. Budeme Vás kontaktovat s potvrzením termínu.</p>\n"
"\n"
"                <table width=\"100%\" style=\"margin:20px 0;border-collapse:collapse;\">\n"
"                    <tr style=\"background:#f5f5f5;\">\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\">Číslo rezervace</td>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;\">BWD-{{ object.id }}</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\">Vozidlo</td>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;\">{{ object.vehicle_type_id.name }} - {{ object.vehicle_info or 'neuvedeno' }}</td>\n"
"                    </tr>\n"
"                    <tr style=\"background:#f5f5f5;\">\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\">Preferovaný termín</td>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;\">{{ object.preferred_date and object.preferred_date.strftime('%d.%m.%Y %H:%M') or 'neuvedeno' }}</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\">Celková cena</td>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;color:#c8a961;\">{{ object.is_price_approximate and 'od ' or '' }}{{ '%.0f' % object.total_price }},- Kč</td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <h3 style=\"color:#1a1a1a;\">Vybrané služby:</h3>\n"
"                <ul style=\"padding-left:20px;\">\n"
"                    % for line in object.line_ids:\n"
"                    <li>{{ line.service_id.name }} - {{ line.price_prefix and line.price_prefix + ' ' or '' }}{{ '%.0f' % line.price }},- Kč</li>\n"
"                    % endfor\n"
"                </ul>\n"
"\n"
"                % if object.customer_note:\n"
"                <p><strong>Vaše poznámka:</strong> {{ object.customer_note }}</p>\n"
"                % endif\n"
"\n"
"                <p style=\"margin-top:20px;color:#666;\">Stav rezervace: <strong style=\"color:#e67e22;\">Čeká na potvrzení</strong></p>\n"
"            </td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"background:#1a1a1a;padding:20px;text-align:center;color:#888;font-size:12px;\">\n"
"                <p style=\"margin:0;\">{{ object.env.company.name }} | {{ object.env.company.street or '' }}, {{ object.env.company.city or '' }}</p>\n"
"            </td>\n"
"        </tr>\n"
"    </table>\n"
"</div>\n"
"            "

