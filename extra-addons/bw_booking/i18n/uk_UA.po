#. module: bw_booking
#: model:mail.template,body_html:bw_booking.mail_template_booking_owner
msgid ""
"<div style=\"font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;max-width:600px;\">\n"
"    <h2 style=\"margin-top:0;\">Nová rezervace BWD-<t t-out=\"object.id\"/></h2>\n"
"    <table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%;\">\n"
"        <tr><td style=\"padding:6px 10px;border:1px solid #ddd;font-weight:bold;\">Zákazník</td><td style=\"padding:6px 10px;border:1px solid #ddd;\" t-out=\"object.customer_name\"/></tr>\n"
"        <tr><td style=\"padding:6px 10px;border:1px solid #ddd;font-weight:bold;\">Telefon</td><td style=\"padding:6px 10px;border:1px solid #ddd;\" t-out=\"object.customer_phone\"/></tr>\n"
"        <tr><td style=\"padding:6px 10px;border:1px solid #ddd;font-weight:bold;\">E-mail</td><td style=\"padding:6px 10px;border:1px solid #ddd;\" t-out=\"object.customer_email\"/></tr>\n"
"        <tr><td style=\"padding:6px 10px;border:1px solid #ddd;font-weight:bold;\">Vozidlo</td><td style=\"padding:6px 10px;border:1px solid #ddd;\"><t t-out=\"object.vehicle_type_id.name\"/> - <t t-out=\"object.vehicle_info or 'neuvedeno'\"/></td></tr>\n"
"        <tr><td style=\"padding:6px 10px;border:1px solid #ddd;font-weight:bold;\">Termín</td><td style=\"padding:6px 10px;border:1px solid #ddd;\" t-out=\"object._bw_preferred_date_str()\"/></tr>\n"
"        <tr><td style=\"padding:6px 10px;border:1px solid #ddd;font-weight:bold;\">Cena</td><td style=\"padding:6px 10px;border:1px solid #ddd;font-weight:bold;\" t-out=\"object._bw_total_price_str()\"/></tr>\n"
"        <tr><td style=\"padding:6px 10px;border:1px solid #ddd;font-weight:bold;\">Jazyk webu</td><td style=\"padding:6px 10px;border:1px solid #ddd;\" t-out=\"object.lang\"/></tr>\n"
"        <tr><td style=\"padding:6px 10px;border:1px solid #ddd;font-weight:bold;\">Reklama</td><td style=\"padding:6px 10px;border:1px solid #ddd;\"><t t-out=\"dict(object._fields['ad_platform']._description_selection(object.env)).get(object.ad_platform, '')\"/><t t-if=\"object.campaign_id\"> - <t t-out=\"object.campaign_id.name\"/></t></td></tr>\n"
"    </table>\n"
"    <h3>Služby</h3>\n"
"    <ul>\n"
"        <li t-foreach=\"object.line_ids\" t-as=\"line\"><t t-out=\"line.service_id.name\"/> - <t t-out=\"object._bw_line_price_str(line)\"/></li>\n"
"    </ul>\n"
"    <p t-if=\"object.customer_note\"><strong>Poznámka:</strong> <t t-out=\"object.customer_note\"/></p>\n"
"    <p style=\"margin-top:24px;\">\n"
"        <a t-att-href=\"'%s/odoo/action-bw_booking.action_bw_booking/%s' % (object.get_base_url(), object.id)\" style=\"background:#c8a961;color:#1a1a1a;padding:10px 18px;text-decoration:none;font-weight:bold;border-radius:4px;\">Otevřít rezervaci v Odoo</a>\n"
"    </p>\n"
"</div>\n"
"            "
msgstr ""

#. module: bw_booking
#: model:mail.template,body_html:bw_booking.mail_template_booking_pending
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;\">\n"
"    <t t-set=\"tx\" t-value=\"object._bw_mail_texts()\"/>\n"
"    <t t-set=\"company\" t-value=\"object.env.company\"/>\n"
"    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;margin:0 auto;background:#ffffff;\">\n"
"        <tr>\n"
"            <td style=\"background:#1a1a1a;padding:30px;text-align:center;\">\n"
"                <h1 style=\"color:#c8a961;margin:0;font-size:24px;\" t-out=\"company.name\"/>\n"
"            </td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding:30px;\">\n"
"                <h2 style=\"color:#1a1a1a;margin-top:0;\" t-out=\"tx['pending_title']\"/>\n"
"                <p><t t-out=\"tx['hello']\"/> <strong t-out=\"object.customer_name\"/>,</p>\n"
"                <p t-out=\"tx['pending_intro']\"/>\n"
"\n"
"                <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:20px 0;border-collapse:collapse;\">\n"
"                    <tr style=\"background:#f5f5f5;\">\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\" t-out=\"tx['reservation_number']\"/>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;\">BWD-<t t-out=\"object.id\"/></td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\" t-out=\"tx['vehicle']\"/>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;\"><t t-out=\"object.vehicle_type_id.name\"/> - <t t-out=\"object.vehicle_info or tx['not_specified']\"/></td>\n"
"                    </tr>\n"
"                    <tr style=\"background:#f5f5f5;\">\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\" t-out=\"tx['preferred_date']\"/>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;\" t-out=\"object._bw_preferred_date_str()\"/>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;\" t-out=\"tx['total_price']\"/>\n"
"                        <td style=\"padding:10px;border:1px solid #ddd;font-weight:bold;color:#a8893f;\" t-out=\"object._bw_total_price_str()\"/>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <h3 style=\"color:#1a1a1a;\"><t t-out=\"tx['services']\"/>:</h3>\n"
"                <ul style=\"padding-left:20px;\">\n"
"                    <li t-foreach=\"object.line_ids\" t-as=\"line\"><t t-out=\"line.service_id.name\"/> - <t t-out=\"object._bw_line_price_str(line)\"/></li>\n"
"                </ul>\n"
"\n"
"                <p t-if=\"object.customer_note\"><strong><t t-out=\"tx['your_note']\"/>:</strong> <t t-out=\"object.customer_note\"/></p>\n"
"\n"
"                <p style=\"margin-top:20px;color:#666;\"><t t-out=\"tx['status']\"/>: <strong style=\"color:#e67e22;\" t-out=\"tx['awaiting']\"/></p>\n"
"            </td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"background:#1a1a1a;padding:20px;text-align:center;color:#888;font-size:12px;\">\n"
"                <p style=\"margin:0;\"><t t-out=\"company.name\"/> | <t t-out=\"object._bw_company_address()\"/><t t-if=\"company.phone\"> | <t t-out=\"company.phone\"/></t></p>\n"
"            </td>\n"
"        </tr>\n"
"    </table>\n"
"</div>\n"
"            "
msgstr ""

